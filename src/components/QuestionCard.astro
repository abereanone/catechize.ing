---
// The question's share image, full size, with a Dark / Light / Solid switch, Share and Download.
// Used on the image page, /quotes/<slug>. "?bg=light" in the address opens that look, so a
// shared link shows the look that was chosen.
// Class names start with "share-card": the site already uses "question-card" for its
// related-question links, with a side-by-side layout.
import { quoteImage, TONES, TONE_LABELS, type Tone } from "@/lib/quoteImages";

interface Props {
  slug: string;
  title: string;
  alt: string;
  tone: Tone;
}
const { slug, title, alt, tone } = Astro.props;
const urls = Object.fromEntries(
  TONES.flatMap((t) => [
    [t, quoteImage(slug, t)],
    [`${t}Thumb`, quoteImage(slug, t, true)],
  ])
);
---

<figure
  class="share-card"
  data-slug={slug}
  data-tone={tone}
  {...Object.fromEntries(Object.entries(urls).map(([k, v]) => [`data-${k.toLowerCase()}`, v]))}
>
  {
    /* The small version paints at once as the background; the full one covers it when it arrives. */
  }
  <img
    class="share-card-image"
    src={quoteImage(slug, tone)}
    alt={alt}
    width="1080"
    height="1080"
    fetchpriority="high"
    decoding="async"
    crossorigin="anonymous"
    style={`background-image:url('${quoteImage(slug, tone, true)}')`}
  />
  <div class="share-card-tones" role="group" aria-label="Look">
    {
      TONES.map((t) => (
        <button
          type="button"
          class="share-card-tone"
          data-tone={t}
          aria-pressed={t === tone ? "true" : "false"}
        >
          {TONE_LABELS[t]}
        </button>
      ))
    }
  </div>
  <figcaption class="share-card-actions">
    <button type="button" class="share-card-button" data-card-share data-card-text={title}>
      Share image
    </button>
    <a
      class="share-card-button"
      href={quoteImage(slug, tone)}
      download={`${slug}-${tone}.jpg`}
      data-card-download
    >
      Download
    </a>
    <p class="share-card-status" role="status" aria-live="polite"></p>
  </figcaption>
</figure>

<script>
  // Phones open the share menu only straight from a tap: anything the tap has to wait for
  // (a download) makes Android refuse, so the first tap did nothing. So each look's picture is
  // fetched once it is shown (from the browser's cache, no second download: the picture is loaded
  // with crossorigin so its cached copy also serves this CORS fetch) and kept ready;
  // the tap then shares at once. Computers copy the picture; failing that, save it.
  document.querySelectorAll<HTMLElement>("figure.share-card").forEach((figure) => {
    const d = figure.dataset;
    const img = figure.querySelector<HTMLImageElement>(".share-card-image")!;
    const share = figure.querySelector<HTMLButtonElement>("[data-card-share]")!;
    const download = figure.querySelector<HTMLAnchorElement>("[data-card-download]")!;
    const status = figure.querySelector<HTMLElement>(".share-card-status")!;
    const say = (t: string) => (status.textContent = t);
    const toneButtons = [...figure.querySelectorAll<HTMLButtonElement>(".share-card-tone")];
    let tone = d.tone!;
    const src = (t: string) => d[t]!;
    const nameFor = (t: string) => `${d.slug}-${t}.jpg`;

    const ready: Record<string, Blob> = {};
    const pending: Record<string, Promise<Blob>> = {};
    const getBlob = (t: string): Promise<Blob> =>
      ready[t]
        ? Promise.resolve(ready[t])
        : (pending[t] ||= fetch(src(t))
            .then((r) => {
              if (!r.ok) throw new Error(String(r.status));
              return r.blob();
            })
            .then((b) => (ready[t] = b))
            .catch((e) => {
              delete pending[t];
              throw e;
            }));
    const fetchWhenShown = () => {
      const t = tone;
      if (img.complete) getBlob(t).catch(() => {});
      else img.addEventListener("load", () => getBlob(t).catch(() => {}), { once: true });
    };

    function setTone(t: string, remember: boolean) {
      tone = t;
      img.style.backgroundImage = `url('${d[`${t}thumb`]}')`;
      img.src = src(t);
      download.href = src(t);
      download.download = nameFor(t);
      toneButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.tone === t)));
      if (remember) {
        const u = new URL(location.href);
        u.searchParams.set("bg", t);
        history.replaceState(null, "", u);
      }
      say("");
      fetchWhenShown();
    }
    toneButtons.forEach((b) => b.addEventListener("click", () => setTone(b.dataset.tone!, true)));
    const asked = new URLSearchParams(location.search).get("bg");
    if (asked && asked !== tone && toneButtons.some((b) => b.dataset.tone === asked))
      setTone(asked, false);
    else fetchWhenShown();

    const save = (b: Blob) => {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(b);
      a.download = nameFor(tone);
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    };
    const isPhone = matchMedia("(pointer: coarse)").matches;
    const link = () => {
      const u = new URL(location.href);
      u.searchParams.set("bg", tone);
      return u.href;
    };
    // Can this browser share a picture file at all? Some phone browsers (e.g. DuckDuckGo on
    // Android, built on WebView) can share only links, or nothing.
    const canSharePictures = (() => {
      try {
        return !!navigator.canShare?.({
          files: [new File(["x"], "x.jpg", { type: "image/jpeg" })],
        });
      } catch {
        return false;
      }
    })();

    share.addEventListener("click", async () => {
      const t = tone;
      say("");
      try {
        if (isPhone && canSharePictures) {
          if (!ready[t]) {
            // Still downloading: wait for it, then ask for one more tap (the wait used up this one).
            say("Getting the picture…");
            await getBlob(t);
            return say("Ready. Tap Share image again.");
          }
          const file = new File([ready[t]], nameFor(t), { type: "image/jpeg" });
          const withLink = { files: [file], text: `${share.dataset.cardText} ${link()}` };
          if (navigator.canShare(withLink)) return await navigator.share(withLink);
          return await navigator.share({ files: [file] });
        }
        if (isPhone) {
          // No picture sharing here. Share the link instead (it previews as this card), or failing
          // that save the picture; a clipboard copy is little use on a phone.
          if (navigator.share) {
            await navigator.share({ title: share.dataset.cardText, url: link() });
            return say(
              "This browser can’t share pictures, so it shared the link, which shows this card."
            );
          }
          save(await getBlob(t));
          return say(
            "This browser can’t share pictures, so the picture is saved to your downloads."
          );
        }
        if (navigator.clipboard?.write && typeof ClipboardItem !== "undefined") {
          // Clipboards take PNG, not JPEG; the promise keeps the copy tied to this tap.
          const png = getBlob(t).then(async (b) => {
            const bmp = await createImageBitmap(b);
            const c = document.createElement("canvas");
            c.width = bmp.width;
            c.height = bmp.height;
            c.getContext("2d")!.drawImage(bmp, 0, 0);
            return new Promise<Blob>((res, rej) =>
              c.toBlob((x) => (x ? res(x) : rej(new Error("png"))), "image/png")
            );
          });
          await navigator.clipboard.write([new ClipboardItem({ "image/png": png })]);
          return say("Picture copied. Paste it into your post or chat.");
        }
        save(await getBlob(t));
        say("Picture saved to your downloads.");
      } catch (e) {
        if ((e as DOMException).name === "AbortError") return;
        try {
          save(await getBlob(t));
          say("Picture saved to your downloads.");
        } catch {
          say("Couldn’t get the picture. Press and hold it to save it.");
        }
      }
    });
  });
</script>

<style>
  .share-card {
    margin: 0 auto;
    max-width: 540px;
  }
  .share-card-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 6px;
    border: 1px solid var(--surface-border);
    background-size: cover;
  }
  .share-card-tones {
    display: flex;
    justify-content: center;
    margin-top: 0.85rem;
  }
  .share-card-tone {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--surface-border-strong);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }
  .share-card-tone + .share-card-tone {
    border-left: 0;
  }
  .share-card-tone:first-child {
    border-radius: 999px 0 0 999px;
  }
  .share-card-tone:last-child {
    border-radius: 0 999px 999px 0;
  }
  .share-card-tone[aria-pressed="true"] {
    background: var(--surface-bg-strong);
    color: var(--color-heading);
  }
  .share-card-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.85rem;
  }
  .share-card-button {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--surface-border-strong);
    background: var(--surface-bg-muted);
    color: var(--color-link);
    text-decoration: none;
    cursor: pointer;
  }
  .share-card-button:hover {
    background: var(--surface-bg-hover);
    color: var(--color-link-hover);
  }
  .share-card-status {
    flex-basis: 100%;
    margin: 0;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .share-card-status:empty {
    display: none;
  }
</style>
