{
  "name": "astro-temp",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build:questions": "node ./scripts/build-questions.mjs",
    "build:bible": "node ./scripts/build-bible-cited.mjs",
    "build:search-index": "node ./scripts/build-questions.mjs",
    "seed:bsb": "node ./bsb-data-pipeline/scripts/prepare-bsb.mjs",
    "check:questions": "node ./scripts/check-questions.mjs",
    "import:catechisms": "node ./scripts/import-catechisms.mjs",
    "new:question": "node ./scripts/new-question.mjs",
    "predev": "npm run build:questions && npm run build:bible && npm run sync:confession-links",
    "dev": "astro dev",
    "prebuild": "npm run build:questions && npm run build:bible && npm run sync:confession-links",
    "build": "astro build",
    "build:worker": "esbuild worker.js --bundle --format=esm --target=es2022 --platform=neutral --outfile=dist/_worker.js",
    "postbuild": "npm run build:worker",
    "preview": "astro preview",
    "astro": "astro",
    "sync:confession-links": "node ./scripts/sync-confession-links.mjs",
    "precheck:types": "npm run build:questions && npm run build:bible && npm run sync:confession-links",
    "check:types": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
